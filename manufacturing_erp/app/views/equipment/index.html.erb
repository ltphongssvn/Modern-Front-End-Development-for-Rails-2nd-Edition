<!-- manufacturing_erp/app/views/equipment/index.html.erb -->
<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Equipment</h1>
    <%= link_to "New Equipment", new_equipment_path, class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full bg-white shadow rounded-lg">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Serial Number</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Production Line</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Next Maintenance</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @equipment.each do |equip| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= link_to equip.name, equip, class: "text-blue-600 hover:underline" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= equip.serial_number %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm"><%= equip.production_line.name %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 py-1 text-xs rounded <%= equip.status == 'operational' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= equip.status %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= equip.next_maintenance&.strftime("%b %d, %Y") || "Not scheduled" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <%= link_to "Edit", edit_equipment_path(equip), class: "text-blue-600 hover:underline mr-3" %>
              <%= link_to "Delete", equip, method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
