<!-- manufacturing_erp/app/views/production_lines/index.html.erb -->
<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Production Lines</h1>
    <%= link_to "New Production Line", new_production_line_path, class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
  </div>

  <div class="grid gap-4">
    <% @production_lines.each do |line| %>
      <div class="bg-white shadow rounded-lg p-6">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-xl font-semibold mb-2"><%= link_to line.name, line, class: "text-blue-600 hover:underline" %></h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
              <div>
                <span class="font-medium">Status:</span>
                <span class="ml-1 px-2 py-1 rounded text-xs <%= line.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                  <%= line.status %>
                </span>
              </div>
              <div>
                <span class="font-medium">Capacity:</span>
                <%= line.capacity %>
              </div>
              <div>
                <span class="font-medium">Output:</span>
                <%= line.current_output %>
              </div>
              <div>
                <span class="font-medium">Efficiency:</span>
                <%= line.efficiency %>%
              </div>
            </div>
            <div class="mt-2 text-sm text-gray-600">
              <span class="font-medium">Location:</span> <%= line.location %>
            </div>
          </div>
          <div class="flex space-x-2">
<% if current_user.can_edit? %>            <%= link_to "Edit", edit_production_line_path(line), class: "text-blue-600 hover:underline" %>
<% end %>
<% if current_user.can_delete? %>            <%= link_to "Delete", line, method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
<% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
