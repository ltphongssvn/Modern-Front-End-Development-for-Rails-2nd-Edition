<!-- manufacturing_erp/app/views/layouts/_navigation.html.erb -->
<nav class="bg-gray-800 text-white p-4">
  <div class="container mx-auto flex justify-between items-center">
    <div class="flex space-x-6">
      <%= link_to "Dashboard", root_path, class: "hover:text-gray-300" %>
      <%= link_to "Production Lines", production_lines_path, class: "hover:text-gray-300" %>
      <%= link_to "Equipment", equipment_index_path, class: "hover:text-gray-300" %>
    </div>
    <div class="flex items-center space-x-4">
      <% if user_signed_in? %>
        <span class="text-gray-400"><%= current_user.email %></span>
        <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "bg-red-600 hover:bg-red-700 px-3 py-1 rounded text-sm" %>
      <% else %>
        <%= link_to "Sign In", new_user_session_path, class: "hover:text-gray-300" %>
      <% end %>
    </div>
  </div>
</nav>
