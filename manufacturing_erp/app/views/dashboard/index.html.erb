<!-- manufacturing_erp/app/views/dashboard/index.html.erb -->
<nav class="bg-gray-800 text-white p-4">
  <div class="container mx-auto flex justify-between items-center">
    <div class="flex space-x-6">
      <%= link_to "Dashboard", root_path, class: "hover:text-gray-300" %>
      <%= link_to "Production Lines", production_lines_path, class: "hover:text-gray-300" %>
      <%= link_to "Equipment", equipment_index_path, class: "hover:text-gray-300" %>
    </div>
  </div>
</nav>

<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-8 text-gray-800">Manufacturing ERP Dashboard</h1>
  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Production Lines Status -->
    <%= turbo_frame_tag "production_status", class: "bg-white rounded-lg shadow p-6" do %>
      <h2 class="text-xl font-semibold mb-4">Production Lines</h2>
      <% @production_lines.each do |line| %>
        <div class="mb-4 p-4 border rounded">
          <div class="flex justify-between items-center">
            <h3 class="font-medium"><%= line.name %></h3>
            <span class="px-2 py-1 text-xs rounded <%= line.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
              <%= line.status.upcase %>
            </span>
  <!-- React Factory Floor Visualization -->
  <div id="factory-floor-visualization" class="col-span-1 lg:col-span-2 mt-6"></div>
          </div>
          <div class="mt-2 text-sm text-gray-600">
            <p>Capacity: <%= line.capacity %> | Output: <%= line.current_output %></p>
            <p>Efficiency: <%= line.efficiency %>%</p>
  <!-- React Factory Floor Visualization -->
  <div id="factory-floor-visualization" class="col-span-1 lg:col-span-2 mt-6"></div>
          </div>
  <!-- React Factory Floor Visualization -->
  <div id="factory-floor-visualization" class="col-span-1 lg:col-span-2 mt-6"></div>
        </div>
      <% end %>
    <% end %>
    
    <!-- Active Alerts -->
    <%= turbo_frame_tag "alerts", class: "bg-white rounded-lg shadow p-6" do %>
      <h2 class="text-xl font-semibold mb-4">Active Alerts</h2>
      <% @active_alerts.each do |alert| %>
        <div class="mb-3 p-3 border-l-4 <%= alert.severity == 'high' ? 'border-red-500 bg-red-50' : 'border-yellow-500 bg-yellow-50' %>">
          <p class="font-medium"><%= alert.alert_type %></p>
          <p class="text-sm text-gray-600"><%= alert.message %></p>
          <p class="text-xs text-gray-500 mt-1"><%= time_ago_in_words(alert.triggered_at) %> ago</p>
  <!-- React Factory Floor Visualization -->
  <div id="factory-floor-visualization" class="col-span-1 lg:col-span-2 mt-6"></div>
        </div>
      <% end %>
    <% end %>
    
    <!-- Upcoming Maintenance -->
    <%= turbo_frame_tag "maintenance", class: "bg-white rounded-lg shadow p-6" do %>
      <h2 class="text-xl font-semibold mb-4">Upcoming Maintenance</h2>
      <% @upcoming_maintenance.each do |schedule| %>
        <div class="mb-3 p-3 border rounded">
          <p class="font-medium"><%= schedule.equipment.name %></p>
          <p class="text-sm text-gray-600"><%= schedule.maintenance_type %></p>
          <p class="text-xs text-gray-500"><%= schedule.scheduled_date.strftime("%B %d, %Y") %></p>
  <!-- React Factory Floor Visualization -->
  <div id="factory-floor-visualization" class="col-span-1 lg:col-span-2 mt-6"></div>
        </div>
      <% end %>
    <% end %>
    
    <!-- Recent Quality Checks -->
    <%= turbo_frame_tag "quality_checks", class: "bg-white rounded-lg shadow p-6" do %>
      <h2 class="text-xl font-semibold mb-4">Recent Quality Checks</h2>
      <% @recent_quality_checks.each do |check| %>
        <div class="mb-3 p-3 border rounded">
          <div class="flex justify-between">
            <span class="font-medium"><%= check.check_type %></span>
            <span class="text-sm <%= check.result == 'Pass' ? 'text-green-600' : 'text-red-600' %>">
              <%= check.result %>
            </span>
  <!-- React Factory Floor Visualization -->
  <div id="factory-floor-visualization" class="col-span-1 lg:col-span-2 mt-6"></div>
          </div>
          <p class="text-xs text-gray-500 mt-1"><%= time_ago_in_words(check.performed_at) %> ago</p>
  <!-- React Factory Floor Visualization -->
  <div id="factory-floor-visualization" class="col-span-1 lg:col-span-2 mt-6"></div>
        </div>
      <% end %>
    <% end %>
  <!-- React Factory Floor Visualization -->
  <div id="factory-floor-visualization" class="col-span-1 lg:col-span-2 mt-6"></div>
  </div>
  <!-- React Factory Floor Visualization -->
  <div id="factory-floor-visualization" class="col-span-1 lg:col-span-2 mt-6"></div>
</div>
